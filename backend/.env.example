PORT=4000

# Managed Postgres (Neon) connection string — same for every environment, no
# local database to install or run. https://neon.tech (free tier). Use a
# separate branch for local dev vs. production so testing locally never
# touches real data — see the README.
DATABASE_URL="postgresql://user:password@ep-your-project-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

JWT_SECRET="replace-with-a-long-random-string"
FRONTEND_URL="http://localhost:3000"

# https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"

# Optional — enables the "Birlikte izle" episode search feature.
# https://console.cloud.google.com (enable "YouTube Data API v3", create an API key)
YOUTUBE_API_KEY=""

# Optional — set all four to send real emails (email verification, password
# reset). Left unset, the API returns the link directly in the response
# instead (dev-mode fallback, no email actually sent).
#
# Quickest option: a Gmail App Password (needs 2FA enabled on the account) —
# https://myaccount.google.com/apppasswords → generate one for "Mail", use
# your Gmail address as SMTP_USER and the 16-character app password as
# SMTP_PASS. Any other SMTP provider (Resend, SendGrid, etc.) works the same
# way — just swap the host/port/credentials.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
