# Backend's URL. Both point at the same server — the first is used for
# REST calls (apiFetch), the second for the Socket.io connection.
# Defaults to localhost:4000 if unset, which only works in local dev.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Optional — the site's own public URL, used for SEO metadata (canonical
# links, sitemap.xml, robots.txt). Defaults to https://dizisenkron.com. Set
# this to your actual deploy URL (e.g. a *.vercel.app address) until the
# real domain is live.
NEXT_PUBLIC_SITE_URL="https://dizisenkron.com"
